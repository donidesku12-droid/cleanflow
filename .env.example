# --- Core ---------------------------------------------------------------
PORT=3001
# Public URL of the app (used in emails: reset links, invitations). Required in production.
APP_URL=http://localhost:5173
# SQLite database file
DATABASE_FILE=./data/cleanflow.db
SESSION_DAYS=14

# --- AI assistant (optional) -------------------------------------------
# Without a key, the built-in grounded rule engine answers from company data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Email via SMTP (optional) -----------------------------------------
# Without SMTP, emails are NOT sent; they are recorded in the delivery log as "not configured".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CLEANFLOW <no-reply@example.com>"
# Inbox for the marketing-site contact form
SALES_INBOX=

# --- SMS via Twilio (optional) -----------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Payments via Stripe (optional) ------------------------------------
# All five are required to enable paid subscriptions. Webhook endpoint: POST /api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
